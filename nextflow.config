
includeConfig 'conf/base.config'

// Singularity
singularity.enabled =       false
singularity.autoMounts =    false

// Docker
docker.enabled = true
docker.registry       = 'quay.io'



// conda
conda.enabled =             true

process {
    maxForks = 4
}

// Data input
params {
    // Data ingestion
    adapters =              '/shared/team/prrsv_apha_data/IDT_UDI_adapters.fasta'
    ref_alignment =         '/shared/team/matt/repos/Shiver_reference_assembly/examples/PRRSV_ref_genomes.fasta'
    
    //shiver_init_dir =       './PRRSV_shiver_init'
    samplesheet =           '/shared/team/prrsv_apha_data/APHA_sequencing_samplesheet.csv'
    data_dir =              '/shared/team/prrsv_apha_data/shiver_inputs'

    // Shiver config    - TODO: build this from NF config file
    //                  - TODO: allow amplicon primer input
    //                  - Check the parameters in this as the default will not always be appropriate 
    //                    for your dataset!
    shiver_config = "${projectDir}/shiver_config.sh"

    stop_after_contig_alignment = false
    use_raw_refs = false
}