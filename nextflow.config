
includeConfig 'conf/base.config'

// Singularity
singularity.enabled =       false
singularity.autoMounts =    false

// Docker
docker.enabled = true
docker.registry       = 'quay.io'



// conda
conda.enabled =             true

process {
    maxForks = 4
}

// Data input
params {
    // Data ingestion
    adapters =              '/Users/arno01m/GitHub_repos/Shiver_reference_assembly/examples/Twist_adapters.fa'
    ref_alignment =         '/Users/arno01m/GitHub_repos/Shiver_reference_assembly/examples/PRRSV_ref_genomes.fasta'
    
    //shiver_init_dir =       './PRRSV_shiver_init'
    samplesheet =           '/Users/arno01m/Desktop/assembler_testing/samplesheet.csv'
    data_dir =              '/Users/arno01m/Desktop/assembler_testing/shiver_input'

    // de novo assembly
    assembler =             'spades' // Options: megahit, spades

    // Shiver config    - TODO: build this from NF config file
    //                  - TODO: allow amplicon primer input
    //                  - Check the parameters in this as the default will not always be appropriate 
    //                    for your dataset!
    shiver_config = "${projectDir}/shiver_config.sh"

    stop_after_contig_alignment = false
    use_raw_refs = false
}

process {

    // If you are not assembling an RNA virus, you may want to remove the --rnaviral flag from the SPAdes command and test other presets.
    withName: 'runSpadesAssembly' {
        ext.args = { " --rnaviral -k 11,21,49,73" }
    }
}